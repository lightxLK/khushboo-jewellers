# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env — it is gitignored.

# Flask environment: "production" or "development"
# In production the app REQUIRES SECRET_KEY to be set and enforces secure cookies + no debug mode.
FLASK_ENV=development

# Random secret used to sign sessions. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_me_with_a_random_64_char_hex_string

# Fallback admin login (used when no AdminUser row exists in the DB yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_me_with_a_strong_password

# Shared secret for the /api/sheet-sync server-to-server endpoint.
# Generate the same way as SECRET_KEY. Must match whatever calls that endpoint (e.g. a Google Apps Script).
SHEET_SYNC_SECRET=replace_me_with_a_random_secret

# Port Flask binds to locally (nginx/gunicorn front this in production).
PORT=5000
